+							imx185_a@1a {
+								status = "disabled";
+							};
+
+							imx318_a@10 {
+								status = "disabled";
+							};
+						};
+					};
+				};
+
+				i2c@c240000 {
+					ncp81599@74 {
+						status = "disabled";
+					};
+
