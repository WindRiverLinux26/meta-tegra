+					tca6408_21: tca6408@21 {
+						status = "disabled";
+					};
+
+					tca9548@77 {
+						status = "disabled";
+
+						i2c@0 {
+							ov5693_a@36 {
+								status = "disabled";
+							};
+						};
+
+						i2c@1 {
+							ov5693_b@36 {
+								status = "disabled";
+							};
+						};
+
