+							GPIO_ACTIVE_HIGH>;
+				};
+
+				spi@3270000 {
+					status = "disabled";
+				};
+			};
+
+			regulator-vdd-3v3-pcie {
+				gpio = <&gpio TEGRA234_MAIN_GPIO(H, 4) GPIO_ACTIVE_HIGH>;
+			};
+
+			firmware {
+				optee {
+					status = "okay";
+				};
+
+				uefi {
+					firmware-media-overlays-applied;
+				};
+			};
+
+			reserved-memory {
+				pva-carveout {
+					nomap;
+					status = "okay";
+					reg = <0x10 0x2d980000 0x00 0x280000>;
+					compatible = "nvidia,pva-carveout";
+				};
