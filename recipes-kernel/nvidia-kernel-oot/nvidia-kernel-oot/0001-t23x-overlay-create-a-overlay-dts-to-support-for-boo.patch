+							ov5693_c@36 {
+								status = "disabled";
+							};
+						};
+
+						i2c@3 {
+							ov5693_d@36 {
+								status = "disabled";
+							};
+						};
+
+						i2c@4 {
+							ov5693_e@36 {
+								status = "disabled";
+							};
+						};
+
+						i2c@5 {
+							ov5693_g@36 {
+								status = "disabled";
+							};
+						};
+					};
+
+					tca9546@70 {
+						status = "disabled";
+
+						i2c@1 {
+							imx274_c@1a {
+								status = "disabled";
+							};
+						};
+
+						i2c@0 {
+							pca9570_a@24 {
+								status = "disabled";
+							};
+
