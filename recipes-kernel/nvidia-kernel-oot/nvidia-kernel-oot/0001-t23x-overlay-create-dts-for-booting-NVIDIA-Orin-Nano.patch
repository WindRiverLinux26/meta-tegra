diff --git a/overlay/tegra234-p3768-0000+p3767-0005-nv-super-boot-overlay.dts b/overlay/tegra234-p3768-0000+p3767-0005-nv-super-boot-overlay.dts
new file mode 100644
index 0000000..cad5a55
--- /dev/null
+++ b/overlay/tegra234-p3768-0000+p3767-0005-nv-super-boot-overlay.dts
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// SPDX-FileCopyrightText: Copyright (C) 2025 Wind River Systems Inc. All rights reserved.
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/tegra234-gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/tegra234-p3767-0000-common.h>
+#include <dt-bindings/thermal/thermal.h>
+
+/ {
+	overlay-name = "Jetson Orin Nano Boot Directly";
+	jetson-header-name = "Jetson Orin Nano Boot Directly";
+	compatible = JETSON_COMPATIBLE;
+
+	fragment@0 {
+		target-path = "/";
+
+		__overlay__ {
+
+			bus@0 {
+
+				mmc@3400000 {
+					status = "okay";
+				};
+
+				pcie@140c0000 {
+					status = "disabled";
+				};
+
+				pcie@14100000 {
+					max-link-speed = <0x03>;
+				};
+
+				pcie@14160000 {
+					status = "okay";
+				};
+
+				pcie-ep@14160000 {
+					status = "disabled";
+				};
+
+				pcie@141e0000 {
+					num-lanes = <0x08>;
+					phys = <&p2u_gbe_0>, <&p2u_gbe_1>;
+					phy-names = "p2u-0", "p2u-1";
+				};
+			};
+
+			cpus {
+				cpu-map {
+					cluster1 {
+						core0 {
+							cpu = <&cpu1_2>;
+						};
+
+						core1 {
+							cpu = <&cpu1_3>;
+						};
+					};
+				};
+			};
+
+			thermal-zones {
+				cpu-thermal {
+					cooling-maps {
+						map-cpufreq {
+							cooling-device = <&cpu0_0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu0_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu1_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						};
+					};
+				};
+
+				gpu-thermal {
+					cooling-maps {
+						map-cpufreq {
+							cooling-device = <&cpu0_0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu0_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu1_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						};
+					};
+				};
+
+				cv0-thermal {
+					cooling-maps {
+						map-cpufreq {
+							cooling-device = <&cpu0_0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu0_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu1_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						};
+					};
+				};
+
+				cv1-thermal {
+					cooling-maps {
+						map-cpufreq {
+							cooling-device = <&cpu0_0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu0_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu1_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						};
+					};
+				};
+
+				cv2-thermal {
+					cooling-maps {
+						map-cpufreq {
+							cooling-device = <&cpu0_0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu0_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu1_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						};
+					};
+				};
+
+				soc0-thermal {
+					cooling-maps {
+						map-cpufreq {
+							cooling-device = <&cpu0_0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu0_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu1_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						};
+					};
+				};
+
+				soc1-thermal {
+					cooling-maps {
+						map-cpufreq {
+							cooling-device = <&cpu0_0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu0_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu1_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						};
+					};
+				};
+
+				soc2-thermal {
+					cooling-maps {
+						map-cpufreq {
+							cooling-device = <&cpu0_0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu0_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT &cpu1_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						};
+					};
+				};
+			};
+
+			chosen {
+				odm-data {
+					hsio-uphy-config-0;
+					hsstp-lane-map-3;
+					gbe-uphy-config-8;
+				};
+			};
+
+			firmware {
+				optee {
+					status = "okay";
+				};
+
+				uefi {
+					firmware-media-overlays-applied;
+				};
+			};
+
+			reserved-memory {
+				pva-carveout {
+					nomap;
+					status = "okay";
+					reg = <0x02 0x73180000 0x00 0x280000>;
+					compatible = "nvidia,pva-carveout";
+				};
+
+				ramoops_carveout {
+					status = "okay";
+					reg = <0x02 0x725f0000 0x00 0x200000>;
+				};
+
+				fsi-carveout {
+					status = "disabled";
+				};
+
+				vpr-carveout {
+					status = "disabled";
+				};
+			};
+
+			aliases {
+				serial0 = "/serial";
+				serial1 = "/bus@0/serial@3100000";
+				serial2 = "/bus@0/serial@3140000";
+			};
+		};
+	};
+};
