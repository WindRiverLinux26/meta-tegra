+/delete-node/ &{/cpus/cpu@20100};
+/delete-node/ &{/cpus/cpu@20200};
+/delete-node/ &{/cpus/cpu@20300};
+/delete-node/ &{/cpus/l2-cache11};
+/delete-node/ &{/cpus/l2-cache20};
+/delete-node/ &{/cpus/l2-cache21};
+/delete-node/ &{/cpus/l2-cache22};
+/delete-node/ &{/cpus/l2-cache23};
+/delete-node/ &{/cpus/l3-cache2};
diff --git a/overlay/Makefile b/overlay/Makefile
index d5e9a0a..6d5fe98 100644
--- a/overlay/Makefile
+++ b/overlay/Makefile
@@ -20,6 +20,7 @@ dtbo-y += tegra234-p3737-0000+p3701-0000-as-p3767-0003.dtbo
 dtbo-y += tegra234-p3737-0000+p3701-0000-as-p3767-0004.dtbo
 dtbo-y += tegra234-p3737-0000+p3701-0000-dynamic.dtbo
 dtbo-y += tegra234-p3768-0000+p3767-0000-dynamic.dtbo
